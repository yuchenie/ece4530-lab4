				<origoptions></origoptions>
				<outputs>
					<output>((OutP + OutN) / 2)
						<evalType>point</evalType>
					</output>
					<output>(20 * log10(((OutP + OutN) / 2)))
						<evalType>point</evalType>
					</output>
					<output>(20 * log10(((vfreq('ac "/out_p") + vfreq('ac "/out_n")) / 2)))
						<evalType>point</evalType>
					</output>
					<output>(db(((OutP + OutN) / 2)))
						<evalType>point</evalType>
					</output>
					<output>db20(VF("/out"))
						<evalType>point</evalType>
					</output>
					<output>VDC("/out'))) ")
						<evalType>point</evalType>
					</output>
					<output>VDC("/out ")
						<evalType>point</evalType>
					</output>
					<output>VDC("/out")
						<evalType>point</evalType>
					</output>
					<output>VDC("/in+)) ")
						<evalType>point</evalType>
					</output>
					<output>VDC("/in+")
						<evalType>point</evalType>
					</output>
					<output>VDC("/in-")
						<evalType>point</evalType>
					</output>
					<output>VT("/out")
						<evalType>point</evalType>
					</output>
					<output>deriv(v("/out" ?result "dc"))
						<evalType>point</evalType>
					</output>
					<output>dB20(VF("/out"))
						<evalType>point</evalType>
					</output>
					<output>phase(VF("/out"))
						<evalType>point</evalType>
					</output>
				</outputs>
			</test>
